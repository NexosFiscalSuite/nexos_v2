# Caddyfile — serve a SPA + proxy do /api na MESMA origem (sem CORS).
#
# O TLS é terminado na borda da Cloudflare (via Cloudflare Tunnel), então aqui o
# Caddy escuta em :80 interno — o cloudflared alcança como http://caddy:80.
#
# Fluxo: usuário -> https://fiscal.solsistema.com.br (Cloudflare) -> Tunnel -> caddy:80
#          /api/*  -> reverse_proxy para a API (FastAPI :8000)
#          resto   -> arquivos estáticos da SPA (fallback SPA: index.html)

:80 {
	encode gzip zstd

	# Backend: tudo sob /api vai para a API. O FastAPI já trata /api/v1/...
	handle /api/* {
		reverse_proxy api:8000
	}

	# Frontend (SPA React/Vite): serve estático com fallback para index.html
	# (necessário para rotas client-side do React Router).
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# Headers de segurança para os assets estáticos da SPA (a API já emite os
	# seus via SecurityHeadersMiddleware). HSTS é injetado pela Cloudflare na borda.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
