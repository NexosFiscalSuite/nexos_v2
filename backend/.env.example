# ─────────────────────────────────────────────────────────────────────────────
# Nexos Fiscal Suite V2 — variáveis de ambiente (prefixo NEXOS_)
# Copie para .env e ajuste. NUNCA commite o .env real.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXOS_ENVIRONMENT=development
NEXOS_DEBUG=true
NEXOS_API_PREFIX=/api/v1

# Banco de dados ──────────────────────────────────────────────────────────────
# database_url: role do APP — NÃO-owner, SUJEITA a RLS. Use no runtime da API.
NEXOS_DATABASE_URL=postgresql+asyncpg://nexos_app:nexos_app@localhost:5432/nexos
# privileged_url: role com BYPASSRLS — usada SÓ por migrações (Alembic) e pelo
# serviço de autenticação (login/signup precisam de operação cross-tenant).
NEXOS_DATABASE_PRIVILEGED_URL=postgresql+asyncpg://nexos:nexos@localhost:5432/nexos
NEXOS_DB_ECHO=false

# JWT ─────────────────────────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
NEXOS_JWT_SECRET=troque-este-segredo-em-producao
NEXOS_ACCESS_TOKEN_TTL_MIN=15
NEXOS_REFRESH_TOKEN_TTL_DAYS=7

# Redis (rate limiting + broker do Celery na Fase 3) ──────────────────────────
NEXOS_REDIS_URL=redis://localhost:6379/0

# Rate limiting ───────────────────────────────────────────────────────────────
# Limite padrão por tenant (fallback). Tiers por plano vêm da tabela `plans`.
NEXOS_RATE_LIMIT_DEFAULT=300/minute

# CORS (separar por vírgula) ──────────────────────────────────────────────────
NEXOS_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Celery (broker/backend; vazio = usa NEXOS_REDIS_URL) ────────────────────────
NEXOS_CELERY_BROKER_URL=
NEXOS_CELERY_RESULT_BACKEND=

# Curadoria das Matrizes Fiscais ──────────────────────────────────────────────
# E-mails (separados por vírgula) autorizados a ESCREVER nas matrizes globais
# (MVA, enquadramento, FCP, protocolos, alíquotas). Vazio = qualquer ADMIN.
NEXOS_MATRIZ_CURADORES=

# Storage de XML ──────────────────────────────────────────────────────────────
# backend: local (dev, grava em disco) | s3 (MinIO/S3)
NEXOS_STORAGE_BACKEND=local
NEXOS_STORAGE_LOCAL_DIR=./data/xml_storage
# Usados só quando STORAGE_BACKEND=s3 (MinIO local do docker-compose):
NEXOS_S3_ENDPOINT_URL=http://localhost:9000
NEXOS_S3_BUCKET=nexos-xml
NEXOS_S3_ACCESS_KEY=nexos
NEXOS_S3_SECRET_KEY=nexos12345
NEXOS_S3_REGION=us-east-1
